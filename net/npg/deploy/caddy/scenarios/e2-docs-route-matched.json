{
  "@id": "docs_route",
  "match": [
    {
      "path": [
        "/docs/*"
      ]
    }
  ],
  "handle": [
    {
      "handler": "headers",
      "response": {
        "set": {
          "X-Edge-Route": [
            "docs"
          ]
        }
      }
    },
    {
      "handler": "file_server",
      "root": "site/docs",
      "index_names": [
        "index.html"
      ]
    }
  ]
}
