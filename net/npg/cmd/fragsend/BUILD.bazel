load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "fragsend_lib",
    srcs = ["main.go"],
    importpath = "github.com/scofe97/runners-lab/net/npg/cmd/fragsend",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//net/npg/internal/announce",
        ],
        "@rules_go//go/platform:linux": [
            "//net/npg/internal/announce",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "fragsend",
    embed = [":fragsend_lib"],
    target_compatible_with = ["@platforms//os:linux"],  # main.go 가 //go:build linux
    visibility = ["//visibility:public"],
)
