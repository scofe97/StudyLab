load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "npgwatch_lib",
    srcs = [
        "edge.go",
        "lab.go",
        "main.go",
    ],
    embedsrcs = ["index.html"],
    importpath = "github.com/scofe97/runners-lab/net/npg/cmd/npgwatch",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "npgwatch",
    embed = [":npgwatch_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "npgwatch_test",
    srcs = [
        "e4_test.go",
        "edge_test.go",
        "lab_test.go",
        "main_test.go",
    ],
    embed = [":npgwatch_lib"],
    deps = ["@com_github_stretchr_testify//require"],
)
