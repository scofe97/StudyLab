load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "npgproxy_lib",
    srcs = ["main.go"],
    importpath = "github.com/scofe97/runners-lab/net/npg/cmd/npgproxy",
    visibility = ["//visibility:private"],
    deps = [
        "//net/npg/internal/proxy",
        "//net/npg/internal/upstream",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_binary(
    name = "npgproxy",
    embed = [":npgproxy_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "npgproxy_test",
    srcs = ["main_test.go"],
    embed = [":npgproxy_lib"],
    deps = [
        "//net/npg/internal/upstream",
        "@com_github_stretchr_testify//require",
    ],
)
