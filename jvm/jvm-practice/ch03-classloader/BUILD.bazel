load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "ch03-classloader",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = [
        "-Xlint:all",
        "-XepDisableAllChecks",
    ],
)

java_library(
    name = "lab_v1",
    srcs = glob(["libsrc/v1/**/*.java"]),
    javacopts = [
        "-Xlint:all",
        "-XepDisableAllChecks",
    ],
)

