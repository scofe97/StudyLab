load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "loadgen_lib",
    srcs = [
        "main.go",
        "sse.go",
        "stats.go",
    ],
    importpath = "github.com/scofe97/runners-lab/jvm/thread-per-request/loadgen",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "loadgen",
    embed = [":loadgen_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "loadgen_test",
    srcs = ["stats_test.go"],
    embed = [":loadgen_lib"],
)
