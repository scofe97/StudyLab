load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "goserver_lib",
    srcs = ["main.go"],
    importpath = "github.com/scofe97/runners-lab/jvm/thread-per-request/goserver",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "goserver",
    embed = [":goserver_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "goserver_test",
    srcs = ["main_test.go"],
    embed = [":goserver_lib"],
)
