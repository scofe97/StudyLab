load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Gradle 프로젝트를 Bazel 이 직접 이해하지 않고, 격리된 복사본에서 ./gradlew test 를 호출한다.
# manual: bazel test //... 에서 빠진다. requires-network: wrapper 배포판·Maven 의존을 받는다.
sh_test(
    name = "gradle_test",
    srcs = ["//tools:run-gradle-test.sh"],
    args = ["arch/hub"],
    data = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "build/**",
            "**/build/**",
            ".gradle/**",
            ".kotlin/**",
        ],
    ),
    env_inherit = [
        "JAVA_HOME",
        "PATH",
    ],
    tags = [
        "manual",
        "requires-network",
    ],
)
